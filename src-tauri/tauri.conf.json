{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Durable Terminal",
  "version": "0.1.0",
  "identifier": "com.durableterminal.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Durable Terminal",
        "width": 1100,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
